+      schema_fail: ok.filter((r) => !r.empty && r.json_lenient_ok && !r.schema_ok).length,
+      finish_length: ok.filter((r) => r.finish_reason === 'length').length,
+      served_models: [...new Set(k.map((r) => r.served_model).filter(Boolean))],
+      providers: Object.fromEntries([...new Set(k.map((r) => r.provider ?? 'unknown'))].map((p) => [p, k.filter((r) => (r.provider ?? 'unknown') === p).length])),
+      prompt_tokens: sum(k.map((r) => r.prompt_tokens)),
+      completion_tokens: sum(k.map((r) => r.completion_tokens)),
+      reasoning_tokens: sum(k.map((r) => r.reasoning_tokens)),
+      cached_prompt_tokens: sum(k.map((r) => r.cached_prompt_tokens)),
