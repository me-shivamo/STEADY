@@ -0,0 +1,321 @@
+// ── Model bake-off instrumentation (BAKE-OFF WORKTREE ONLY — never ship) ──────
+// Lives only in the scratchpad worktree. It lets scripts/eval/run.ts swap the
+// model behind each of the two LLM calls the in-process eval makes, and
+// records one JSONL row per OpenRouter call: model actually served, provider,
+// tokens (incl. reasoning + cached), latency, cost, and whether the reply was
+// empty / not JSON / the wrong shape.
+//
+//   BAKE_PARSE_MODEL   parse step (scripts/eval/run.ts)        default openai/gpt-4o-mini
+//   BAKE_MATCH_MODEL   matcher (macroResolver.ts matchCall)    default openai/gpt-4o-mini
+//   BAKE_PARSE_EXTRA / BAKE_MATCH_EXTRA
+//                      JSON merged into that call's request body. A null value
+//                      DELETES the key, e.g.
+//                      '{"temperature":null,"reasoning":{"effort":"low"}}'
+//
+// Node-only (process.env, node:fs); run.ts calls bakeInit() before any call.
+
+import { appendFileSync, writeFileSync, existsSync, readFileSync, mkdirSync } from 'node:fs'
+import { join } from 'node:path'
+
+export type BakeKind = 'parse' | 'match'
+
+const env = (k: string): string | undefined => (globalThis as any).process?.env?.[k]
+
+export function bakeModel(kind: BakeKind): string {
+  const v = env(kind === 'parse' ? 'BAKE_PARSE_MODEL' : 'BAKE_MATCH_MODEL')
+  return v && v.trim() ? v.trim() : 'openai/gpt-4o-mini'
+}
+
+export function bakeExtra(kind: BakeKind): Record<string, unknown> {
+  const raw = env(kind === 'parse' ? 'BAKE_PARSE_EXTRA' : 'BAKE_MATCH_EXTRA')
+  if (!raw || !raw.trim()) return {}
+  const v = JSON.parse(raw)
+  if (v === null || typeof v !== 'object' || Array.isArray(v)) throw new Error(`BAKE_${kind.toUpperCase()}_EXTRA must be a JSON object`)
+  return v
+}
+
+// ── run state ────────────────────────────────────────────────────────────────
+export interface CallRow {
+  ts: string
+  label: string
+  case_id: string | null
+  rep: number | null
+  kind: BakeKind
+  call_in_case: number            // 1 = first call of this kind for this case run; match 2 = the retry
+  requested_model: string
+  served_model: string | null     // json.model — what OpenRouter actually ran
+  provider: string | null
+  generation_id: string | null
+  http_status: number | null
+  ok: boolean
+  error: string | null            // truncated error body / exception text
+  latency_ms: number
+  prompt_tokens: number | null
+  completion_tokens: number | null
+  reasoning_tokens: number | null
+  cached_prompt_tokens: number | null
+  cost_usd: number | null
+  cost_source: 'openrouter_usage' | 'list_price' | 'unknown'
+  finish_reason: string | null
+  native_finish_reason: string | null
+  content_chars: number
+  reasoning_chars: number
+  empty: boolean
+  json_strict_ok: boolean         // JSON.parse(content) as-is
+  json_lenient_ok: boolean        // after stripping a ``` fence (what production's parseAiContent tolerates for parse)
+  schema_ok: boolean
+  schema_issue: string | null
+  fatal: boolean
+}
+
+interface Pricing { prompt: number; completion: number; internal_reasoning?: number }
+
+const state = {
+  label: 'unlabelled',
+  dir: '' as string,
+  jsonl: '' as string,
+  caseId: null as string | null,
+  rep: null as number | null,
+  perCaseCounts: new Map<string, number>(),
+  rows: [] as CallRow[],
+  fatal: null as string | null,
+  consecutiveHttpErrors: 0,
+  prices: new Map<string, Pricing>(),
+  modelsMeta: new Map<string, any>(),
+}
+
+export const bakeRows = () => state.rows
+export const bakeFatal = () => state.fatal
+export const bakeDir = () => state.dir
+
+export function bakeContext(caseId: string | null, rep: number | null) {
+  state.caseId = caseId
+  state.rep = rep
+  state.perCaseCounts.clear()
+}
+
+export class BakeFatalError extends Error {}
+
+// Public model list (no auth): exists? pricing? supported params? Cached per run dir.
+async function loadModels(): Promise<void> {
+  const cache = join(state.dir, '..', '_openrouter_models.json') // shared by all runs; delete it to refresh prices
+  let data: any
+  if (existsSync(cache)) data = JSON.parse(readFileSync(cache, 'utf8'))
+  else {
+    const res = await fetch('https://openrouter.ai/api/v1/models')
+    if (!res.ok) throw new Error(`could not load OpenRouter model list: ${res.status}`)
+    data = await res.json()
+    writeFileSync(cache, JSON.stringify(data))
+  }
+  for (const m of data.data ?? []) {
+    state.modelsMeta.set(m.id, m)
+    const p = m.pricing ?? {}
+    state.prices.set(m.id, {
+      prompt: Number(p.prompt ?? NaN),
+      completion: Number(p.completion ?? NaN),
+      internal_reasoning: p.internal_reasoning != null ? Number(p.internal_reasoning) : undefined,
+    })
+  }
+}
+
+export interface BakeInitInfo {
+  models: Record<BakeKind, { id: string; extra: Record<string, unknown>; listed: boolean; pricing?: Pricing; supported_parameters?: string[]; context_length?: number }>
+  warnings: string[]
+}
+
+export async function bakeInit(label: string, dir: string, opts: { force?: boolean } = {}): Promise<BakeInitInfo> {
+  state.label = label
+  state.dir = dir
+  mkdirSync(dir, { recursive: true })
+  state.jsonl = join(dir, 'calls.jsonl')
+  if (existsSync(state.jsonl) && !opts.force) {
+    throw new Error(`${state.jsonl} already exists — pick a new label or set BAKE_FORCE=1 to overwrite`)
+  }
+  await loadModels()
+  const warnings: string[] = []
+  const models = {} as BakeInitInfo['models']
+  for (const kind of ['parse', 'match'] as const) {
+    const id = bakeModel(kind)
+    const extra = bakeExtra(kind)
+    const meta = state.modelsMeta.get(id)
+    models[kind] = {
+      id, extra, listed: !!meta,
+      pricing: state.prices.get(id),
+      supported_parameters: meta?.supported_parameters,
+      context_length: meta?.context_length,
+    }
+    if (!meta) { warnings.push(`${kind}: "${id}" is not in OpenRouter's public model list (typo, or gated?)`); continue }
+    const sp: string[] = meta.supported_parameters ?? []
+    if (kind === 'match' && !sp.includes('response_format')) warnings.push(`match: ${id} does not list response_format — json_object mode may be ignored`)
+    if (!sp.includes('temperature') && !('temperature' in extra)) warnings.push(`${kind}: ${id} does not list temperature — consider BAKE_${kind.toUpperCase()}_EXTRA='{"temperature":null}'`)
+    if (sp.includes('reasoning') && !('reasoning' in extra)) warnings.push(`${kind}: ${id} supports reasoning and none is set — it runs at the provider default effort (cost/latency!). Set BAKE_${kind.toUpperCase()}_EXTRA='{"reasoning":{"effort":"low"}}' (or minimal / {"enabled":false}) to pin it`)
+  }
+  if (Object.values(models).some((m) => !m.listed) && env('BAKE_ALLOW_UNLISTED') !== '1') {
+    throw new Error(`model not in OpenRouter's list: ${warnings.join('; ')} (BAKE_ALLOW_UNLISTED=1 to override)`)
+  }
+  writeFileSync(state.jsonl, '')
+  return { models, warnings }
+}
+
+// ── the fetch wrapper ────────────────────────────────────────────────────────
+const FENCED = /^```[a-zA-Z]*\s*([\s\S]*?)\s*```$/
+
+function tryJson(s: string): { ok: boolean; value?: any } {
+  try { return { ok: true, value: JSON.parse(s) } } catch { return { ok: false } }
+}
+
+function schemaCheck(kind: BakeKind, v: any, requestBody: any): string | null {
+  if (v === null || typeof v !== 'object' || Array.isArray(v)) return 'not a JSON object'
+  if (kind === 'parse') {
+    if (typeof v.intent !== 'string') return 'intent missing'
+    if (v.intent !== 'log') return null
+    if (!Array.isArray(v.foods) || v.foods.length === 0) return 'intent=log but foods empty/missing'
+    for (const f of v.foods) {
+      if (!f || typeof f.name !== 'string' || !f.name.trim()) return 'food without name'
+      if (typeof f.quantity_g !== 'number' || !Number.isFinite(f.quantity_g) || f.quantity_g <= 0) return `food "${f.name}" quantity_g not a positive number`
+    }
+    return null
+  }
+  // match: one entry per "Food N:" block in the prompt
+  const prompt = String(requestBody?.messages?.[0]?.content ?? '')
+  const expected = (prompt.match(/^Food \d+: "/gm) ?? []).length
+  if (!Array.isArray(v.matches)) return 'matches missing'
+  if (expected && v.matches.length !== expected) return `matches has ${v.matches.length} entries, expected ${expected}`
+  for (const m of v.matches) {
+    if (!m || typeof m !== 'object') return 'match entry not an object'
+    if (!(m.candidate_index === null || m.candidate_index === undefined || typeof m.candidate_index === 'number')) return 'candidate_index not number|null'
+    if (!(m.est_per_100g == null || typeof m.est_per_100g === 'object')) return 'est_per_100g not object|null'
+    if (m.candidate_index == null && m.est_per_100g == null) return 'neither candidate nor estimate'
+  }
+  return null
+}
+
+const num = (x: unknown): number | null => (typeof x === 'number' && Number.isFinite(x) ? x : null)
+
+function listPriceCost(model: string, p: number | null, c: number | null): number | null {
+  const pr = state.prices.get(model)
+  if (!pr || !Number.isFinite(pr.prompt) || !Number.isFinite(pr.completion) || p == null || c == null) return null
+  // OpenRouter bills reasoning tokens as completion tokens (they are inside completion_tokens).
+  return p * pr.prompt + c * pr.completion
+}
+
+const isFatalBody = (status: number, body: string) =>
+  status === 402 || status === 403 || status === 401 || /key limit exceeded/i.test(body)
+
+// Same signature as fetch(url, init). Merges the bake extras into the body,
+// times the call, records a row, and hands the caller an equivalent Response.
+export async function bakeFetch(kind: BakeKind, url: string, init: { method: string; headers: Record<string, string>; body: string }): Promise<Response> {
+  if (state.fatal) throw new BakeFatalError(`bake aborted earlier: ${state.fatal}`)
+  const body = JSON.parse(init.body)
+  for (const [k, v] of Object.entries(bakeExtra(kind))) {
+    if (v === null) delete body[k]
+    else body[k] = v
+  }
+  body.usage = { include: true } // OpenRouter usage accounting → usage.cost, reasoning/cached token details
+
+  const key = state.caseId ?? '_'
+  const n = (state.perCaseCounts.get(`${key}:${kind}`) ?? 0) + 1
+  state.perCaseCounts.set(`${key}:${kind}`, n)
+
+  const row: CallRow = {
+    ts: new Date().toISOString(), label: state.label, case_id: state.caseId, rep: state.rep, kind, call_in_case: n,
+    requested_model: body.model, served_model: null, provider: null, generation_id: null,
+    http_status: null, ok: false, error: null, latency_ms: 0,
+    prompt_tokens: null, completion_tokens: null, reasoning_tokens: null, cached_prompt_tokens: null,
+    cost_usd: null, cost_source: 'unknown', finish_reason: null, native_finish_reason: null,
+    content_chars: 0, reasoning_chars: 0, empty: false, json_strict_ok: false, json_lenient_ok: false,
+    schema_ok: false, schema_issue: null, fatal: false,
+  }
+
+  const t0 = Date.now()
+  let res: Response
+  let text: string
+  try {
+    res = await fetch(url, { ...init, body: JSON.stringify(body) })
+    text = await res.text()
+    if (!res.ok) text = text.replace(/"user_id"\s*:\s*"[^"]*"/g, '"user_id":"<redacted>"')
+  } catch (err) {
+    row.latency_ms = Date.now() - t0
+    row.error = `fetch threw: ${String((err as Error)?.message ?? err).slice(0, 300)}`
+    record(row)
+    throw err
+  }
+  row.latency_ms = Date.now() - t0
+  row.http_status = res.status
+
+  if (!res.ok) {
+    row.error = text.slice(0, 400)
+    if (isFatalBody(res.status, text)) {
+      row.fatal = true
+      state.fatal = `HTTP ${res.status} on ${kind} call: ${text.slice(0, 200)}`
+    }
+    if (++state.consecutiveHttpErrors >= 5 && !state.fatal) state.fatal = `5 consecutive HTTP errors (last ${res.status})`
+    record(row)
+    return new Response(text, { status: res.status })
+  }
+  state.consecutiveHttpErrors = 0
+
+  const parsed = tryJson(text)
+  if (!parsed.ok) {
+    row.error = `response body not JSON: ${text.slice(0, 200)}`
+    record(row)
+    return new Response(text, { status: res.status })
+  }
+  const json = parsed.value
+  // OpenRouter can return 200 with an error object (upstream provider failure).
+  if (json?.error) {
+    row.error = `200 with error: ${JSON.stringify(json.error).slice(0, 300)}`
+    const msg = JSON.stringify(json.error)
+    if (/key limit exceeded/i.test(msg) || json.error?.code === 402 || json.error?.code === 403) {
+      row.fatal = true
+      state.fatal = `error object on ${kind} call: ${msg.slice(0, 200)}`
+    }
+  }
+  row.ok = !json?.error
+  row.served_model = json?.model ?? null
+  row.provider = json?.provider ?? null
+  row.generation_id = json?.id ?? null
+  const u = json?.usage ?? {}
+  row.prompt_tokens = num(u.prompt_tokens)
+  row.completion_tokens = num(u.completion_tokens)
+  row.reasoning_tokens = num(u.completion_tokens_details?.reasoning_tokens)
+  row.cached_prompt_tokens = num(u.prompt_tokens_details?.cached_tokens)
+  if (num(u.cost) !== null) { row.cost_usd = u.cost; row.cost_source = 'openrouter_usage' }
+  else {
+    const est = listPriceCost(body.model, row.prompt_tokens, row.completion_tokens)
+    if (est !== null) { row.cost_usd = est; row.cost_source = 'list_price' }
+  }
+  const choice = json?.choices?.[0]
+  row.finish_reason = choice?.finish_reason ?? null
+  row.native_finish_reason = choice?.native_finish_reason ?? null
+  const content: string = typeof choice?.message?.content === 'string' ? choice.message.content : ''
+  const reasoning: string = typeof choice?.message?.reasoning === 'string' ? choice.message.reasoning : ''
+  row.content_chars = content.length
+  row.reasoning_chars = reasoning.length
+  row.empty = content.trim() === ''
+  if (!row.empty) {
+    const strict = tryJson(content)
+    row.json_strict_ok = strict.ok
+    let value = strict.value
+    if (!strict.ok) {
+      const fence = content.trim().match(FENCED)
+      const lenient = fence ? tryJson(fence[1].trim()) : { ok: false }
+      row.json_lenient_ok = lenient.ok
+      value = lenient.value
+    } else row.json_lenient_ok = true
+    if (row.json_lenient_ok) {
+      row.schema_issue = schemaCheck(kind, value, body)
+      row.schema_ok = row.schema_issue === null
+    } else if (kind === 'parse') {
+      row.schema_issue = 'not JSON'
+    } else row.schema_issue = 'not JSON'
+  } else row.schema_issue = 'empty content'
+
+  record(row)
+  return new Response(text, { status: res.status })
+}
+
+function record(row: CallRow) {
+  state.rows.push(row)
+  if (state.jsonl) appendFileSync(state.jsonl, JSON.stringify(row) + '\n')
+}
